<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ backup rules. Login cookies in files/account.json, the WebDAV password in
   files/webdav.json and the custom AI key in files/custom_ai.json never go to cloud backup;
   device-to-device transfer keeps the default (everything), so a phone migration stays signed in.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="account.json"/>
        <exclude domain="file" path="webdav.json"/>
        <exclude domain="file" path="custom_ai.json"/>
    </cloud-backup>
</data-extraction-rules>
